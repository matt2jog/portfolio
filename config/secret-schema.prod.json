{
  "schema_version": 1,
  "service": "portfolio",
  "environment": "prod",
  "infisical_path": "/services/portfolio",
  "bundles": {
    "database_bootstrap": {
      "target_secret": "portfolio-database-bootstrap-bundle-prod",
      "fields": {
        "DATABASE_ADMIN_URL": {"source": "PORTFOLIO_DATABASE_ADMIN_URL", "type": "uri", "required": true},
        "RUNTIME_DATABASE_URL": {"source": "PORTFOLIO_RUNTIME_DATABASE_URL", "type": "uri", "required": true},
        "MIGRATION_DATABASE_URL": {"source": "PORTFOLIO_MIGRATION_DATABASE_URL", "type": "uri", "required": true},
        "LEGAL_AUDIT_DATABASE_URL": {"source": "PORTFOLIO_LEGAL_AUDIT_DATABASE_URL", "type": "uri", "required": true},
        "LEGACY_READER_DATABASE_URL": {"source": "PORTFOLIO_LEGACY_READER_DATABASE_URL", "type": "uri", "required": true},
        "SOURCE_FENCE_DATABASE_URL": {"source": "PORTFOLIO_SOURCE_FENCE_DATABASE_URL", "type": "uri", "required": true},
        "SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"}
      }
    },
    "runtime": {
      "target_secret": "portfolio-runtime-bundle-prod",
      "fields": {
        "ADMIN_AUTHORITY_URL": {"source": "PORTFOLIO_ADMIN_AUTHORITY_URL", "type": "https_url", "required": true},
        "ADMIN_IDENTITY_AUDIENCE": {"source": "PORTFOLIO_ADMIN_IDENTITY_AUDIENCE", "type": "string", "required": true},
        "ADMIN_IDENTITY_ISSUER": {"source": "PORTFOLIO_ADMIN_IDENTITY_ISSUER", "type": "https_url", "required": true},
        "ADMIN_IDENTITY_JWKS_URL": {"source": "PORTFOLIO_ADMIN_IDENTITY_JWKS_URL", "type": "https_url", "required": true},
        "CAREER_PUBSUB_PUSH_AUDIENCE": {"source": "PORTFOLIO_CAREER_PUBSUB_PUSH_AUDIENCE", "type": "https_url", "required": true},
        "CAREER_PUBSUB_PUSH_SERVICE_ACCOUNT": {"source": "PORTFOLIO_CAREER_PUBSUB_PUSH_SERVICE_ACCOUNT", "type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]{2,62}@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$"},
        "CAREER_PUBSUB_SUBSCRIPTION": {"source": "PORTFOLIO_CAREER_PUBSUB_SUBSCRIPTION", "type": "string", "required": true, "pattern": "^projects\\/[a-z][a-z0-9-]{4,28}[a-z0-9]\\/subscriptions\\/[A-Za-z][A-Za-z0-9._~+%-]{2,254}$"},
        "DATABASE_URL": {"source": "PORTFOLIO_RUNTIME_DATABASE_URL", "type": "uri", "required": true},
        "EDGE_ORIGIN_TOKEN": {"source": "PORTFOLIO_EDGE_ORIGIN_TOKEN", "type": "string", "required": true, "min_length": 32, "max_length": 256, "pattern": "^[A-Za-z0-9_-]+$"},
        "EDGE_ORIGIN_PREVIOUS_TOKEN": {"source": "PORTFOLIO_EDGE_ORIGIN_PREVIOUS_TOKEN", "type": "string", "required": false, "min_length": 32, "max_length": 256, "pattern": "^[A-Za-z0-9_-]+$"},
        "FIREWORKS_AI_TOKEN": {"source": "PORTFOLIO_FIREWORKS_AI_TOKEN", "type": "string", "required": true},
        "GRADIENT_AI_TOKEN": {"source": "PORTFOLIO_GRADIENT_AI_TOKEN", "type": "string", "required": true},
        "SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"}
      }
    },
    "deployment": {
      "target_secret": "portfolio-deployment-bundle-prod",
      "fields": {
        "CLOUDFLARE_API_TOKEN": {"source": "PORTFOLIO_CLOUDFLARE_API_TOKEN", "type": "string", "required": true, "min_length": 20},
        "EDGE_ORIGIN_TOKEN": {"source": "PORTFOLIO_EDGE_ORIGIN_TOKEN", "type": "string", "required": true, "min_length": 32, "max_length": 256, "pattern": "^[A-Za-z0-9_-]+$"},
        "EDGE_ORIGIN_PREVIOUS_TOKEN": {"source": "PORTFOLIO_EDGE_ORIGIN_PREVIOUS_TOKEN", "type": "string", "required": false, "min_length": 32, "max_length": 256, "pattern": "^[A-Za-z0-9_-]+$"},
        "MIGRATION_DATABASE_URL": {"source": "PORTFOLIO_MIGRATION_DATABASE_URL", "type": "uri", "required": true},
        "SOURCE_FENCE_DATABASE_URL": {"source": "PORTFOLIO_SOURCE_FENCE_DATABASE_URL", "type": "uri", "required": true},
        "SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"}
      }
    },
    "legal_audit": {
      "target_secret": "portfolio-legal-audit-bundle-prod",
      "fields": {
        "LEGAL_AUDIT_DATABASE_URL": {"source": "PORTFOLIO_LEGAL_AUDIT_DATABASE_URL", "type": "uri", "required": true},
        "SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"}
      }
    },
    "data_migration": {
      "target_secret": "portfolio-data-migration-bundle-prod",
      "fields": {
        "LEGACY_PORTFOLIO_DATABASE_URL": {"source": "PORTFOLIO_LEGACY_READER_DATABASE_URL", "type": "uri", "required": true},
        "LEGACY_PORTFOLIO_SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "LEGACY_PORTFOLIO_SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "LEGACY_PORTFOLIO_SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"},
        "SOURCE_FENCE_DATABASE_URL": {"source": "PORTFOLIO_SOURCE_FENCE_DATABASE_URL", "type": "uri", "required": true},
        "TARGET_PORTFOLIO_DATABASE_URL": {"source": "PORTFOLIO_MIGRATION_DATABASE_URL", "type": "uri", "required": true},
        "TARGET_PORTFOLIO_SUPABASE_CA_CERT": {"source": "PORTFOLIO_SUPABASE_CA_CERT", "type": "pem", "required": true},
        "TARGET_PORTFOLIO_SUPABASE_CA_SHA256": {"source": "PORTFOLIO_SUPABASE_CA_SHA256", "type": "string", "required": true, "pattern": "^[a-f0-9]{64}$"},
        "TARGET_PORTFOLIO_SUPABASE_PROJECT_REF": {"source": "PORTFOLIO_SUPABASE_PROJECT_REF", "type": "string", "required": true, "pattern": "^qvbpgvazqfyhwjsfulsb$"}
      }
    }
  }
}
