# Server runtime
NODE_ENV=development
PORT=3000
# Set this to an isolated non-production Supabase database. CI alone supplies a
# localhost URL for its disposable pgvector integration-test container.
DATABASE_URL=
# DEPLOYMENT_STAGE=staging
SUPABASE_PROJECT_REF=
SUPABASE_CA_CERT=
SUPABASE_CA_SHA256=

# Optional projects cache TTL (server-side, in minutes; default 60)
# PROJECTS_CACHE_TTL_MINUTES=60

# Optional local connection TLS certificate.
# SUPABASE_CA_CERT_PATH=./certs/supabase-ca.pem
PUBLIC_BASE_URL=http://localhost:3000

# Public project chat providers.
GRADIENT_AI_TOKEN=
FIREWORKS_AI_TOKEN=

# Public GitHub activity works without a token. Add only a least-privilege,
# read-only token if higher API limits are needed.
GITHUB_USERNAME=matt2jog
# GITHUB_TOKEN=
