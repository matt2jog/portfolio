# Server runtime
NODE_ENV=development
PORT=3000
# Local development may use file:./var/career.db. Cloud Run receives the shared
# environment-specific Turso URL and token from Infisical.
TURSO_DATABASE_URL=file:./var/career.db
TURSO_AUTH_TOKEN=

# Optional projects cache TTL (server-side, in minutes; default 60)
# PROJECTS_CACHE_TTL_MINUTES=60

PUBLIC_BASE_URL=http://localhost:3000

# Public project chat providers.
GRADIENT_AI_TOKEN=
FIREWORKS_AI_TOKEN=

# Public GitHub activity works without a token. Add only a least-privilege,
# read-only token if higher API limits are needed.
GITHUB_USERNAME=matt2jog
# GITHUB_TOKEN=
