# Server runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=replace-with-strong-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=http://localhost:3000/auth/google/callback
# Optional fallback used if CALLBACK_URL is not set
# CALLBACK_URL_FALLBACK=http://localhost:3000/auth/google/callback

# Optional traffic policy
# When true, requests are limited to US IPs (localhost/private networks are always allowed).
ENFORCE_US_ONLY=true

# Optional LinkedIn activity ingestion
# Uses a public, no-cookie Apify actor by default.
# LINKEDIN_PROVIDER=apify_public
# LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-public-handle/
# APIFY_TOKEN=your-apify-token
# APIFY_LINKEDIN_POSTS_ACTOR_ID=harvestapi~linkedin-profile-posts
# LINKEDIN_SYNC_MAX_POSTS=100
# LINKEDIN_SYNC_COOLDOWN_MINUTES=60
# LINKEDIN_CACHE_TTL_MINUTES=60

# Optional projects cache TTL (server-side, in minutes; default 60)
# PROJECTS_CACHE_TTL_MINUTES=60

# Optional admin allowlists
# Comma-separated lists
# ALLOWED_ADMIN_EMAIL=admin@example.com
# ALLOWED_ADMIN_SUB=google-sub-id

# Optional Supabase TLS cert settings
# SUPABASE_CA_CERT_PATH=./certs/supabase-ca.pem
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
