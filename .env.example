# Server runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=replace-with-strong-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=http://localhost:3000/auth/google/callback
# Optional fallback used if CALLBACK_URL is not set
# CALLBACK_URL_FALLBACK=http://localhost:3000/auth/google/callback

# Optional admin allowlists
# Comma-separated lists
# ALLOWED_ADMIN_EMAIL=admin@example.com
# ALLOWED_ADMIN_SUB=google-sub-id

# Optional Supabase TLS cert settings
# SUPABASE_CA_CERT_PATH=./certs/supabase-ca.pem
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
