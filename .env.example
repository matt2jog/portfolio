# Server runtime
NODE_ENV=development
PORT=3000
# Set this to an isolated non-production Supabase database. CI alone supplies a
# localhost URL for its disposable pgvector integration-test container.
# Production receives a Supabase URL from the pinned portfolio-runtime-bundle-prod version.
DATABASE_URL=

# Optional traffic policy
# When true, requests are limited to US IPs (localhost/private networks are always allowed).
ENFORCE_US_ONLY=true

# Optional projects cache TTL (server-side, in minutes; default 60)
# PROJECTS_CACHE_TTL_MINUTES=60

# Optional local connection TLS certificate. Production receives the certificate from
# the pinned runtime bundle and never reads a certificate path from this file.
# SUPABASE_CA_CERT_PATH=./certs/supabase-ca.pem
ADMIN_AUTHORITY_URL=https://admin.2jog.dev
ADMIN_IDENTITY_ISSUER=https://admin.2jog.dev
ADMIN_IDENTITY_AUDIENCE=2jog-services
ADMIN_IDENTITY_JWKS_URL=https://admin.2jog.dev/.well-known/jwks.json
PUBLIC_BASE_URL=http://localhost:3000
