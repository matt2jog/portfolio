{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["ORIGIN_ACCESS_TOKEN"]
  },
  "routes": [
    { "pattern": "2jog.dev/*", "zone_name": "2jog.dev" },
    { "pattern": "www.2jog.dev/*", "zone_name": "2jog.dev" }
  ],
  "vars": {
    "ORIGIN_URL": "https://portfolio--prod-hqojlnvxwa-uk.a.run.app"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
