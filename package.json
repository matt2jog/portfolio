{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "cross-env NODE_ENV=development tsx watch src/backend/bootstrap.ts",
    "build": "tsx src/scripts/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "lint": "eslint .",
    "check": "tsc",
    "test:ui": "playwright test --config src/tests/ui-test/playwright.config.ts",
    "test:live-smoke": "tsx src/tests/live-smoke.ts",
    "test:client-unit": "tsx --test src/tests/client-unit/*.test.ts",
    "test:client-unit-coverage": "c8 --include='src/client/src/**/*.{ts,tsx}' --exclude='src/tests/**' --reporter=json --reports-dir=coverage/client/unit npm run test:client-unit",
    "build:client-coverage": "cross-env VITE_COVERAGE=1 vite build",
    "serve:client-coverage": "node --import tsx src/tests/client-coverage/serve.ts",
    "test:client-coverage": "tsx src/tests/client-coverage/prepare.ts && npm run test:client-unit-coverage && npm run build:client-coverage && cross-env CLIENT_COVERAGE=1 playwright test --config src/tests/ui-test/playwright.config.ts && tsx src/tests/client-coverage/report.ts",
    "test:pictures": "playwright test --config src/tests/ui-artifacts/playwright.config.ts",
    "test:pictures:verify": "tsx src/tests/ui-artifacts/verify-screenshots.ts",
    "test:backend-unit": "tsx --test src/tests/backend-unit/*.test.ts",
    "test:backend-integration": "tsx --test --test-concurrency=1 src/tests/backend-integration/*.test.ts",
    "test:backend": "tsx --test --test-concurrency=1 src/tests/backend-unit/*.test.ts src/tests/backend-integration/*.test.ts",
    "test:coverage": "c8 --exclude='src/scripts/migrate.ts' --check-coverage --lines 70 --branches 70 --functions 70 --statements 70 --reporter text --reporter json-summary npm run test:backend",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:transfer": "tsx src/scripts/transfer-career-data.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.0.1",
    "framer-motion": "^12.27.1",
    "gsap": "^3.14.2",
    "input-otp": "^1.4.2",
    "jsdom": "^29.1.1",
    "katex": "^0.16.44",
    "lucide-react": "^0.545.0",
